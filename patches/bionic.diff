-// Use our own incrementer to cut down on the total number of calls.
-static size_t LargeSetIncrement(size_t len) {
-  if (len >= 4096) {
-    return 4096;
-  } else if (len >= 1024) {
-    return 1024;
-  } else if (len >= 256) {
-    return 256;
-  }
-  return 1;
-}
