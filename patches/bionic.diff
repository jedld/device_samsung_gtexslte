-void RunCmpBufferOverreadTest(
-    void (*test_cmp_func)(uint8_t*, uint8_t*, size_t),
-    void (*test_miscmp_func)(uint8_t*, uint8_t*, size_t, size_t)) {
-  // In order to verify that functions are not reading past the end of either
