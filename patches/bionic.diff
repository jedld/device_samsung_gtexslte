-  rewind(fp);
-  ASSERT_EQ(2U, fread(&buf[0], 1, buf.size(), fp));
-  ASSERT_EQ('1', buf[0]);
-  ASSERT_EQ('2', buf[1]);
-
-  fclose(fp);
