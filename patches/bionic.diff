-static void* SemWaitEINTRThreadFn(void* arg) {
-  sem_t* sem = reinterpret_cast<sem_t*>(arg);
-  uintptr_t have_eintr = 0;
-  uintptr_t have_error = 0;
-  while (true) {
-    int result = sem_wait(sem);
-    if (result == 0) {
-      break;
-    }
-    if (result == -1) {
-      if (errno == EINTR) {
-        have_eintr = 1;
-      } else {
-        have_error = 1;
-        break;
-      }
-    }
-  }
-  return reinterpret_cast<void*>((have_eintr << 1) | have_error);
-}
