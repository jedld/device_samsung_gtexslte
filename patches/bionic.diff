-std::string XmlEscape(const std::string& xml) {
-  std::string escaped;
-  escaped.reserve(xml.size());
-
-  for (auto c : xml) {
-    switch (c) {
-    case '<':
-      escaped.append("&lt;");
-      break;
-    case '>':
-      escaped.append("&gt;");
-      break;
-    case '&':
-      escaped.append("&amp;");
-      break;
-    case '\'':
-      escaped.append("&apos;");
-      break;
-    case '"':
-      escaped.append("&quot;");
-      break;
-    default:
-      escaped.append(1, c);
-      break;
-    }
-  }
-
-  return escaped;
-}
