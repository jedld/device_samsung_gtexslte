-TEST(search, insque_remque) {
-  q_node zero(0);
-  q_node one(1);
-  q_node two(2);
-
-  // Linear (not circular).
-
-  insque(&zero, NULL);
-  insque(&one, &zero);
-  insque(&two, &one);
-
-  int expected = 0;
-  for (q_node* q = &zero; q != NULL; q = q->next) {
-    ASSERT_EQ(expected, q->i);
-    ++expected;
-  }
-  ASSERT_EQ(3, expected);
-
-  for (q_node* q = &two; q != NULL; q = q->prev) {
-    --expected;
-    ASSERT_EQ(expected, q->i);
-  }
-  ASSERT_EQ(0, expected);
