-  enum Progress {
-    LOCK_INITIALIZED,
-    LOCK_WAITING,
-    LOCK_RELEASED,
-    LOCK_ACCESSED,
-    LOCK_TIMEDOUT,
-  };
-  std::atomic<Progress> progress;
-  std::atomic<pid_t> tid;
-  std::function<int (pthread_rwlock_t*)> trylock_function;
