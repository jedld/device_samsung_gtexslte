-#if defined(IFF_DORMANT)
-  if ((flags & IFF_DORMANT) != 0) result += " DORMANT";
-#endif
-#if defined(IFF_ECHO)
-  if ((flags & IFF_ECHO) != 0) result += " ECHO";
