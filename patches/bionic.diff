-  // ...so it's worth testing the direct seek path too.
-  errno = 0;
-  ASSERT_EQ(-1, fseek(fp, 0, SEEK_SET));
-  ASSERT_EQ(ESPIPE, errno);
-
-  fclose(fp);
-#else
-  GTEST_LOG_(INFO) << "glibc uses fopencookie instead.\n";
-#endif
