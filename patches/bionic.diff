-  char buf[sizeof(DELAY_MSG)];
-  ASSERT_EQ(static_cast<ssize_t>(sizeof(DELAY_MSG)), read(fd, buf, sizeof(DELAY_MSG)));
-  ASSERT_STREQ(DELAY_MSG, buf);
