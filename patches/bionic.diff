-  if ((*pid = fork()) == 0) {
-    close(fds[0]);
-    usleep(5000);
-    EXPECT_EQ(5, write(fds[1], DELAY_MSG, sizeof(DELAY_MSG)));
-    close(fds[1]);
-    exit(0);
-  }
-  ASSERT_LT(0, *pid);
-  close(fds[1]);
-
-  *fd = fds[0];
-}
