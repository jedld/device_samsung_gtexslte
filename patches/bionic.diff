-static void AddGtestFilterSynonym(std::vector<char*>& args) {
-  // Support --gtest-filter as a synonym for --gtest_filter.
-  for (size_t i = 1; i < args.size(); ++i) {
-    if (strncmp(args[i], "--gtest-filter", strlen("--gtest-filter")) == 0) {
-      args[i][7] = '_';
-    }
-  }
-}
