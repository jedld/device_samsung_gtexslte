-  ASSERT_EQ(2, head->next->i);
-  ASSERT_EQ(0, head->next->next->i);
-  ASSERT_EQ(2, head->next->next->next->i);
-
-  remque(&two);
-  ASSERT_EQ(0, head->i);
-  ASSERT_EQ(0, head->next->i);
-
-  remque(&zero);
-}
